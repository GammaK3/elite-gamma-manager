# URL del proyecto Supabase (ficticia; reemplazar por la URL real).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Preferida: publishable key pública del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR_CON_LA_CLAVE_PUBLICA

# Compatibilidad heredada: usar solo si aún no se configuró la publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=REEMPLAZAR_CON_LA_CLAVE_ANON_PUBLICA
